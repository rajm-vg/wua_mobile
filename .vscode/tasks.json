        {
            "label": "Backend: Run (Docker + MySQL + JDK 21 + Spring Boot)",
            "type": "shell",
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}/../wrd_backend"
            },
            "command": "docker info *> $null; if ($LASTEXITCODE -ne 0) { Write-Host 'Starting Docker Desktop...'; Start-Process 'C:\\Program Files\\Docker\\Docker\\Docker Desktop.exe'; $i = 0; while ($i -lt 30) { Start-Sleep -Seconds 2; docker info *> $null; if ($LASTEXITCODE -eq 0) { break }; $i++ }; if ($LASTEXITCODE -ne 0) { throw 'Docker Desktop did not start in time.' } }; $running = docker ps --filter 'name=^/mysql$' --format '{{.Names}}'; if ($running -ne 'mysql') { Write-Host 'Starting MySQL container...'; docker start mysql }; . .\\use-jdk21.ps1; .\\mvnw.cmd",
